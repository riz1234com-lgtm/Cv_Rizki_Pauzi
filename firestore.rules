rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'riz1234.com@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. User Profile Record
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Education Timeline
    match /education/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(itemId);
    }

    // 3. Skills
    match /skills/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(itemId);
    }

    // 4. Projects Showcase
    match /projects/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(itemId);
    }

    // 5. Gallery Documentation
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(itemId);
    }

    // 6. Certificates & Licenses
    match /certificates/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(itemId);
    }

    // 7. Site Global Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Contact Inquiries / Messages
    match /messages/{messageId} {
      allow create: if isValidId(messageId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100 &&
        incoming().email is string && incoming().email.size() > 0 && incoming().email.size() <= 150 &&
        incoming().message is string && incoming().message.size() > 0 && incoming().message.size() <= 3000 &&
        incoming().isRead == false;
      allow read, update, delete: if isAdmin() && isValidId(messageId);
    }

    // 9. Admin Directory
    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false; // Only manageable from backend/console
    }
  }
}
